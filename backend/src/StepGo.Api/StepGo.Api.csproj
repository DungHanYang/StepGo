<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StepGo.Api.Shared\StepGo.Api.Shared.csproj" />
    <ProjectReference Include="..\StepGo.Application\StepGo.Application.csproj" />
    <ProjectReference Include="..\StepGo.Infrastructure\StepGo.Infrastructure.csproj" />
    <ProjectReference Include="..\StepGo.Contracts\StepGo.Contracts.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <AssemblyName>bootstrap</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

</Project>
