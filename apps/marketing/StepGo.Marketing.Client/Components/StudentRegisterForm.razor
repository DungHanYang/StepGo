@namespace StepGo.Marketing.Client.Components
@using System.ComponentModel.DataAnnotations

@if (_submitted)
{
    <div class="stepgo-card flex flex-col gap-2" role="status">
        <p>註冊完成！</p>
        <a href="/auth/login" class="stepgo-btn stepgo-btn--student self-start">前往登入</a>
    </div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleValidSubmit" class="stepgo-card flex flex-col gap-3">
        <DataAnnotationsValidator />

        <label class="flex flex-col gap-1">
            姓名
            <InputText @bind-Value="_model.Name" class="rounded-stepgo border border-stepgo-border bg-white px-2 py-1" />
            <ValidationMessage For="() => _model.Name" />
        </label>

        <label class="flex flex-col gap-1">
            手機號碼 <span class="text-stepgo-danger">*</span>
            <InputText @bind-Value="_model.Phone" class="rounded-stepgo border border-stepgo-border bg-white px-2 py-1" />
            <ValidationMessage For="() => _model.Phone" />
        </label>

        <label class="flex flex-col gap-1">
            Email（選填）
            <InputText @bind-Value="_model.Email" class="rounded-stepgo border border-stepgo-border bg-white px-2 py-1" />
            <ValidationMessage For="() => _model.Email" />
        </label>
        <OwlTip Title="小提醒">填寫 Email 才能收到自動通知。</OwlTip>

        <button type="submit" class="stepgo-btn stepgo-btn--student">完成註冊</button>
    </EditForm>
}

@code {
    [Parameter] public string? CourseId { get; set; }

    private readonly StudentRegisterModel _model = new();
    private bool _submitted;

    private void HandleValidSubmit()
    {
        // Mock-first: no backend yet, so registration is a purely local state change — no
        // network request is made (frontend-auth spec: real-time validation happens entirely
        // client-side before any such call would occur).
        _submitted = true;
    }

    public sealed class StudentRegisterModel
    {
        [Required(ErrorMessage = "請輸入姓名")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "手機號碼為必填")]
        [Phone(ErrorMessage = "手機號碼格式不正確")]
        public string Phone { get; set; } = string.Empty;

        // Intentionally no [Required] — frontend-auth spec: "Email 欄位 SHALL 為選填".
        [EmailAddress(ErrorMessage = "Email 格式不正確")]
        public string? Email { get; set; }
    }
}
