@namespace StepGo.Marketing.Client.Components
@inject NavigationManager Nav

<Button Variant="student" OnClick="GoToEnroll">立即報名</Button>

@code {
    [Parameter, EditorRequired] public string CourseId { get; set; } = string.Empty;
    [Parameter] public string CourseName { get; set; } = string.Empty;

    private void GoToEnroll()
    {
        // frontend-auth handles the shared login/register entry; the student checkout
        // flow itself (frontend-student-portal) picks up from there once authenticated.
        Nav.NavigateTo($"/auth/register?role=student&courseId={Uri.EscapeDataString(CourseId)}");
    }
}
